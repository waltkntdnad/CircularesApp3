<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CircularesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Circulares"
        tools:targetApi="31">

        <!-- Pantalla principal (visualización para todos los usuarios) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Visor a pantalla completa de una circular -->
        <activity
            android:name=".ui.viewer.ViewerActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Inicio de sesión del administrador -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Panel del administrador -->
        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Carga de archivos -->
        <activity
            android:name=".ui.upload.UploadActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminActivity" />

        <!-- Reportes y estadísticas -->
        <activity
            android:name=".ui.reports.ReportsActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminActivity" />

        <!-- Servicio de mensajería FCM (notificación push opcional al subir circular) -->
        <service
            android:name=".notifications.CircularMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Icono de notificación por defecto de FCM -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />

    </application>

</manifest>
